# Application
CRYPTOPILOT_ENVIRONMENT=development
CRYPTOPILOT_EXECUTION_MODE=research_only
CRYPTOPILOT_LOG_LEVEL=INFO

# Binance public market data
CRYPTOPILOT_BINANCE_REST_BASE_URL=https://data-api.binance.vision
CRYPTOPILOT_BINANCE_WS_BASE_URL=wss://data-stream.binance.vision/ws

# Infrastructure
CRYPTOPILOT_REDIS_URL=redis://localhost:6379/0

# HTTP reliability
CRYPTOPILOT_REQUEST_TIMEOUT_SECONDS=10
CRYPTOPILOT_REQUEST_MAX_RETRIES=3
